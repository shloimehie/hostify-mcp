{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hostify-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    { "new_sqlite_classes": ["HostifyMCP"], "tag": "v1" },
    { "new_sqlite_classes": ["HostifyMCPV2"], "tag": "v2" }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "HostifyMCPV2", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "112cbff650414567a18ca30408819245" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hostify-data",
      "database_id": "a6391176-d4ac-4523-b407-fe8b07ebf85c"
    }
  ],
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": { "SYNC_PAGES_PER_RUN": "14", "SYNC_HISTORY_DAYS": "60", "SYNC_DAILY_WRITE_SOFT_CAP": "50000", "SYNC_DAILY_WRITE_HARD_CAP": "80000" },
  "observability": { "enabled": true }
}
